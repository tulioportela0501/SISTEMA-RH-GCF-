# ---------------------------------------------------------------
# Sistema RH GCF — variáveis de ambiente (copie para .env)
# NÃO coloque senhas reais neste arquivo de exemplo.
# ---------------------------------------------------------------

# Conexão com o PostgreSQL
DATABASE_URL=postgres://rh_gcf:TROQUE_ESTA_SENHA@localhost:5432/rh_gcf
# Use "true" em bancos na nuvem que exigem SSL (Neon, Supabase, RDS...)
DATABASE_SSL=false

# Endereço público do sistema (usado na proteção contra requisições de outros sites)
APP_URL=https://rh.seudominio.com.br

# "true" quando o sistema roda atrás de um proxy (Caddy, Nginx, Tailscale Serve)
TRUST_PROXY=false

# Cookie de sessão só por HTTPS. Em produção deixe em branco (fica seguro automaticamente).
# Use "false" somente para testar no próprio computador via http://localhost.
COOKIE_SECURE=

# Primeiro administrador (usado só pelo comando npm run db:seed-admin; pode apagar depois)
ADMIN_NOME=Administrador RH
ADMIN_LOGIN=admin
ADMIN_SENHA=

# Backup (npm run db:backup)
BACKUP_DIR=./backups
BACKUP_RETENCAO_DIAS=30
# Caminho do pg_dump no Windows, se não estiver no PATH:
# PG_DUMP=C:\Program Files\PostgreSQL\16\bin\pg_dump.exe

# Docker (docker-compose.yml)
POSTGRES_PASSWORD=
DOMINIO=rh.seudominio.com.br
