# ---------------------------------------------------------------
# Sistema RH GCF — variáveis de ambiente (copie para .env)
# NÃO coloque senhas reais neste arquivo de exemplo.
# ---------------------------------------------------------------

# Conexão MySQL (Hostinger → painel → MySQL → seus dados)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=rh_gcf
DB_USER=rh_gcf
DB_PASSWORD=TROQUE_ESTA_SENHA

# Tamanho máximo do pool de conexões (padrão: 10)
# DB_POOL_MAX=10

# Endereço público do sistema (usado na proteção CSRF)
APP_URL=https://rh.seudominio.com.br

# "true" quando o sistema roda atrás de um proxy reverso (Hostinger, Nginx, Caddy)
TRUST_PROXY=true

# Cookie de sessão só por HTTPS. Em produção deixe em branco (fica seguro automaticamente).
# Use "false" somente para testar localmente via http://localhost.
COOKIE_SECURE=

# Primeiro administrador (usado só por: npm run db:seed-admin; pode apagar depois)
ADMIN_NOME=Administrador RH
ADMIN_LOGIN=admin
ADMIN_SENHA=

# Backup (npm run db:backup)
BACKUP_DIR=./backups
BACKUP_RETENCAO_DIAS=30
# Caminho do mysqldump se não estiver no PATH:
# MYSQLDUMP=/usr/bin/mysqldump
